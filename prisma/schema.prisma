generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  username            String
  email               String   @unique
  password            String
  isMailVerified      Boolean? @default(false)
  otpForVerification  String?  @default("")
  otpForResetPassword String?  @default("")
  provider            String?  @default("local")
  providerId          String?
  UserAddedAt         DateTime @default(now())

  // Relations
  accounts        Account[]
  activeAccountId String?
  activeAccount   Account?  @relation("ActiveAccount", fields: [activeAccountId], references: [id])
}

model Account {
  id        String   @id @default(cuid())
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  activeUsers User[] @relation("ActiveAccount")

  todos    Todo[]
  profiles Profile[]
}

model Todo {
  id          String   @id @default(uuid())
  title       String
  description String?
  links       Json?
  priority    String?  @default("Low")
  list        String?  @default("Personal")
  visibility  String?  @default("Private")
  date        String?
  time        String?
  tags        Json?
  subTasks    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status    String?  @default("pending") // values: "pending", "done", "rejected"
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  media TodoMedia[]

  @@index([accountId])
}

model TodoMedia {
  id        Int      @id @default(autoincrement())
  publicUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todoId String
  todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([todoId])
}

model Profile {
  id        Int      @id @default(autoincrement())
  publicUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
